{
  "name": "screensound-electron-spike",
  "version": "0.0.1",
  "private": true,
  "description": "Spike: prove nut.js can inject synthetic input (move+click+type+Enter) into other apps on macOS — the make-or-break feature for migrating screensound to Electron.",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "test": "node --test \"src/**/*.test.ts\"",
    "build:renderer": "esbuild src/capture-spike.ts src/telegram-spike.ts --bundle --format=iife --outdir=.",
    "start:capture": "pnpm build:renderer && SPIKE=capture electron . --no-sandbox",
    "start:telegram": "pnpm build:renderer && SPIKE=telegram electron . --no-sandbox"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "@nut-tree-fork/libnut", "esbuild"]
  }
}
