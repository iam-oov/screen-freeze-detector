{
  "name": "screensound-electron",
  "version": "0.1.0",
  "private": true,
  "description": "screensound (Electron): monitors screen zones and reacts when they freeze — sound alert, synthetic Enter via nut.js, and a Telegram remote.",
  "main": "main.js",
  "scripts": {
    "start": "pnpm build:renderer && electron . --no-sandbox",
    "test": "node --test \"src/**/*.test.ts\"",
    "build:renderer": "esbuild src/capture-spike.ts --bundle --format=iife --outdir=.",
    "pack": "pnpm build:renderer && electron-builder --mac --dir",
    "dist": "pnpm build:renderer && electron-builder --mac"
  },
  "build": {
    "appId": "ai.tiriel.screensound",
    "productName": "screensound",
    "directories": { "output": "dist", "buildResources": "assets" },
    "files": ["**/*", "!**/*.ts", "!.env", "!README.md", "!assets/**/*"],
    "asarUnpack": ["**/*.node", "node_modules/@nut-tree-fork/**"],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "identity": null
    }
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "@nut-tree-fork/libnut", "esbuild"]
  }
}
